# =============================================================================
# Warehouse — production environment template
# =============================================================================
# On the VPS (/root/SIU_WAREHOUSE):
#   cp .env.production.template .env.production
#   nano .env.production   # fill secrets; URL-encode special chars in DATABASE_URL
#   chmod 600 .env.production
#
# This file is read at RUNTIME only (docker compose env_file). Nothing from it
# is ever passed to the Docker image build.
#
# The app listens on 127.0.0.1:${APP_PORT} only; the host reverse proxy must
# target http://127.0.0.1:3009
# =============================================================================

# --- PostgreSQL (used by the `db` service in docker-compose) -----------------
# Keep the database port unpublished; only the `app`/`migrate` containers
# join the network.
#   openssl rand -base64 24
POSTGRES_USER=warehouse_app
POSTGRES_PASSWORD=REPLACE_WITH_OPENSSL_RAND_BASE64_24
POSTGRES_DB=warehouse

# --- Prisma ------------------------------------------------------------------
# Host `db` is the Docker Compose service name (TLS not required on the bridge).
# If the password contains @ : / ? # [ ] encode them (RFC 3986) in the URL.
DATABASE_URL="postgresql://warehouse_app:REPLACE_WITH_OPENSSL_RAND_BASE64_24@db:5432/warehouse?schema=public&sslmode=disable&connection_limit=10&pool_timeout=20"

# --- App ---------------------------------------------------------------------
# Host port, bound to 127.0.0.1 only (reverse proxy -> http://127.0.0.1:3009).
APP_PORT=3009

# --- Authentication (Auth.js v5) -----------------------------------------------
# REQUIRED. Signs/encrypts the session cookie. Generate once per environment:
#   openssl rand -base64 32
# Rotating it signs every user out. (NEXTAUTH_SECRET is still accepted as a
# fallback, but use AUTH_SECRET.)
AUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32
# REQUIRED behind the reverse proxy: trust X-Forwarded-Host/Proto.
# (NEXTAUTH_URL alone does NOT enable this in Auth.js v5.)
AUTH_TRUST_HOST=true
# Public HTTPS origin of the site, e.g. https://warehouse.example.com
AUTH_URL=https://warehouse.example.com

# --- First admin (used only by `npm run db:seed`, never by the running app) ----
# Only needed for a brand-new database. If ADMIN_PASSWORD is empty the seed
# generates a strong password and prints it once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
