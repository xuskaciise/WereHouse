// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Add seed script configuration
// Run with: npm run db:seed

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String?    @unique
  name         String
  username     String     @unique
  passwordHash String? // bcrypt hash, never plaintext
  role         Role       @default(STUDENT)
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  stockMovements          StockMovement[]
  purchaseOrders          PurchaseOrder[]
  salesOrders             SalesOrder[]
  supplierPayments        SupplierPayment[]
  customerPayments        CustomerPayment[]
  stockTransfers          StockTransfer[]
  purchaseReceives        PurchaseReceive[]
  purchaseItemAdjustments PurchaseOrderItemAdjustment[]
  expenses                Expense[]
  expenseCategories       ExpenseCategory[]
  categories              Category[]
  products                Product[]
  suppliers               Supplier[]
  customers               Customer[]
  warehouses              Warehouse[]
  stocks                  Stock[]

  @@map("users")
}

enum Role {
  ADMIN
  WAREHOUSE_MANAGER
  SALES_OFFICER
  ACCOUNTANT
  STUDENT
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  products Product[]

  @@index([userId])
  @@map("categories")
}

model Product {
  id           String    @id @default(cuid())
  name         String
  sku          String    @unique
  description  String?
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id])
  costPrice    Decimal   @default(0) @db.Decimal(12, 2)
  sellingPrice Decimal   @default(0) @db.Decimal(12, 2)
  reorderLevel Int       @default(10)
  issueDate    DateTime?
  expireDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  userId       String?
  user         User?     @relation(fields: [userId], references: [id])

  stock              Stock[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  salesOrderItems    SalesOrderItem[]
  stockTransferItems StockTransferItem[]

  @@index([userId])
  @@index([categoryId])
  @@map("products")
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String?
  address       String?
  city          String?
  state         String?
  zipCode       String?
  country       String?
  contactPerson String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])

  purchaseOrders   PurchaseOrder[]
  supplierPayments SupplierPayment[]

  @@index([userId])
  @@map("suppliers")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  salesOrders      SalesOrder[]
  customerPayments CustomerPayment[]

  @@index([userId])
  @@map("customers")
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  city      String?
  state     String?
  zipCode   String?
  country   String?
  capacity  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  stock              Stock[]
  stockMovements     StockMovement[]
  purchaseOrders     PurchaseOrder[]
  salesOrders        SalesOrder[]
  fromStockTransfers StockTransfer[] @relation("FromWarehouse")
  toStockTransfers   StockTransfer[] @relation("ToWarehouse")

  @@index([userId])
  @@map("warehouses")
}

model Stock {
  id               String      @id @default(cuid())
  productId        String
  product          Product     @relation(fields: [productId], references: [id])
  warehouseId      String
  warehouse        Warehouse   @relation(fields: [warehouseId], references: [id])
  quantity         Int         @default(0)
  reservedQuantity Int         @default(0)
  status           StockStatus @default(IN_STOCK)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  userId           String?
  user             User?       @relation(fields: [userId], references: [id])

  @@unique([productId, warehouseId])
  @@index([userId])
  @@index([warehouseId])
  @@map("stock")
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

model StockMovement {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  type        MovementType
  quantity    Int
  reference   String?
  referenceId String?
  notes       String?
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  createdAt   DateTime     @default(now())

  @@index([createdAt])
  @@index([productId, warehouseId])
  @@index([userId, createdAt])
  @@map("stock_movements")
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

model PurchaseOrder {
  id                   String      @id @default(cuid())
  orderNumber          String      @unique
  supplierId           String
  supplier             Supplier    @relation(fields: [supplierId], references: [id])
  warehouseId          String
  warehouse            Warehouse   @relation(fields: [warehouseId], references: [id])
  orderDate            DateTime    @default(now())
  expectedDeliveryDate DateTime?
  status               OrderStatus @default(PENDING)
  subtotal             Decimal     @default(0) @db.Decimal(12, 2)
  tax                  Decimal     @default(0) @db.Decimal(12, 2)
  discount             Decimal     @default(0) @db.Decimal(12, 2)
  total                Decimal     @default(0) @db.Decimal(12, 2)
  notes                String?
  userId               String
  user                 User        @relation(fields: [userId], references: [id])
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  items            PurchaseOrderItem[]
  supplierPayments SupplierPayment[]
  receives         PurchaseReceive[]

  @@index([status])
  @@index([orderDate])
  @@index([supplierId])
  @@index([userId, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  // Current (adjusted) quantity: changed by edits before the first receive,
  // over-receiving and closing the remainder. subtotal always follows it.
  quantity         Int
  // Quantity as ordered when the PO was created; never changes.
  originalQuantity Int
  // The supplier will not deliver the rest; quantity was reduced to received.
  closed           Boolean       @default(false)
  unitPrice        Decimal       @db.Decimal(12, 2)
  subtotal         Decimal       @db.Decimal(12, 2)
  createdAt        DateTime      @default(now())

  receiveItems PurchaseReceiveItem[]
  adjustments  PurchaseOrderItemAdjustment[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model PurchaseReceive {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  notes           String?
  createdAt       DateTime      @default(now())

  items       PurchaseReceiveItem[]
  adjustments PurchaseOrderItemAdjustment[]

  @@index([purchaseOrderId])
  @@map("purchase_receives")
}

model PurchaseReceiveItem {
  id                  String            @id @default(cuid())
  purchaseReceiveId   String
  purchaseReceive     PurchaseReceive   @relation(fields: [purchaseReceiveId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  // 0 only when the line's remainder is closed in this receive.
  quantityReceived    Int

  @@index([purchaseOrderItemId])
  @@map("purchase_receive_items")
}

// History of every change to a purchase order item's quantity, with who,
// when and why (the reason is required for OVER_RECEIVE / CLOSE_REMAINING).
model PurchaseOrderItemAdjustment {
  id                  String                 @id @default(cuid())
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem      @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  purchaseReceiveId   String?
  purchaseReceive     PurchaseReceive?       @relation(fields: [purchaseReceiveId], references: [id], onDelete: Cascade)
  type                PurchaseAdjustmentType
  oldQuantity         Int
  newQuantity         Int
  reason              String?
  userId              String
  user                User                   @relation(fields: [userId], references: [id])
  createdAt           DateTime               @default(now())

  @@index([purchaseOrderItemId])
  @@index([purchaseReceiveId])
  @@map("purchase_order_item_adjustments")
}

enum PurchaseAdjustmentType {
  EDIT
  OVER_RECEIVE
  CLOSE_REMAINING
}

model SupplierPayment {
  id              String         @id @default(cuid())
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  amount          Decimal        @db.Decimal(12, 2)
  paymentDate     DateTime       @default(now())
  paymentMethod   String
  reference       String?
  notes           String?
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  createdAt       DateTime       @default(now())

  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([paymentDate])
  @@index([userId, createdAt])
  @@map("supplier_payments")
}

model SalesOrder {
  id                   String      @id @default(cuid())
  orderNumber          String      @unique
  customerId           String
  customer             Customer    @relation(fields: [customerId], references: [id])
  warehouseId          String
  warehouse            Warehouse   @relation(fields: [warehouseId], references: [id])
  orderDate            DateTime    @default(now())
  expectedDeliveryDate DateTime?
  status               OrderStatus @default(PENDING)
  subtotal             Decimal     @default(0) @db.Decimal(12, 2)
  tax                  Decimal     @default(0) @db.Decimal(12, 2)
  discount             Decimal     @default(0) @db.Decimal(12, 2)
  total                Decimal     @default(0) @db.Decimal(12, 2)
  notes                String?
  userId               String
  user                 User        @relation(fields: [userId], references: [id])
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  items            SalesOrderItem[]
  customerPayments CustomerPayment[]

  @@index([status])
  @@index([orderDate])
  @@index([customerId])
  @@index([userId, createdAt])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Int
  unitPrice    Decimal    @db.Decimal(12, 2)
  subtotal     Decimal    @db.Decimal(12, 2)
  createdAt    DateTime   @default(now())

  @@index([salesOrderId])
  @@index([productId])
  @@map("sales_order_items")
}

model CustomerPayment {
  id            String      @id @default(cuid())
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  salesOrderId  String?
  salesOrder    SalesOrder? @relation(fields: [salesOrderId], references: [id])
  amount        Decimal     @db.Decimal(12, 2)
  paymentDate   DateTime    @default(now())
  paymentMethod String
  reference     String?
  notes         String?
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([customerId])
  @@index([salesOrderId])
  @@index([paymentDate])
  @@index([userId, createdAt])
  @@map("customer_payments")
}

model StockTransfer {
  id              String      @id @default(cuid())
  transferNumber  String      @unique
  fromWarehouseId String
  fromWarehouse   Warehouse   @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse   @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  transferDate    DateTime    @default(now())
  status          OrderStatus @default(PENDING)
  notes           String?
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items StockTransferItem[]

  @@map("stock_transfers")
}

model StockTransferItem {
  id              String        @id @default(cuid())
  stockTransferId String
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  createdAt       DateTime      @default(now())

  @@map("stock_transfer_items")
}

enum OrderStatus {
  PENDING
  PARTIALLY_RECEIVED
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model ExpenseCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  // lower(trim(name)): makes names unique case-insensitively (set by the API).
  nameKey     String   @unique
  description String?
  // Inactive categories stay on old expenses but cannot be chosen for new ones.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  expenses Expense[]

  @@index([userId])
  @@map("expense_categories")
}

model Expense {
  id            String          @id @default(cuid())
  categoryId    String
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount        Decimal         @db.Decimal(12, 2)
  description   String
  expenseDate   DateTime        @default(now())
  paymentMethod String
  reference     String?
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([expenseDate])
  @@index([userId, createdAt])
  @@map("expenses")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}
