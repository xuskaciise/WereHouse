// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Add seed script configuration
// Run with: npm run db:seed

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String     @id @default(cuid())
  email                  String?    @unique
  name                   String
  username               String     @unique
  passwordHash           String? // bcrypt hash, never plaintext
  role                   Role       @default(STUDENT)
  status                 UserStatus @default(PENDING)
  // Warehouse preselected in forms. Set by an admin (Users) or by the user
  // in their profile unless the admin locked it.
  defaultWarehouseId     String?
  defaultWarehouse       Warehouse? @relation("UserDefaultWarehouse", fields: [defaultWarehouseId], references: [id], onDelete: SetNull)
  defaultWarehouseLocked Boolean    @default(false)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  stockMovements          StockMovement[]
  purchaseOrders          PurchaseOrder[]
  salesOrders             SalesOrder[]
  supplierPayments        SupplierPayment[]
  customerPayments        CustomerPayment[]
  stockTransfers          StockTransfer[]
  purchaseReceives        PurchaseReceive[]
  purchaseItemAdjustments PurchaseOrderItemAdjustment[]
  permissionChanges       PermissionChangeLog[]
  landedCosts             PurchaseLandedCost[]
  landedCostLogs          LandedCostLog[]
  valuationEntries        InventoryValuationEntry[]
  transferReceipts        StockTransferReceipt[]
  transferEvents          StockTransferEvent[]
  transferCosts           StockTransferCost[]
  expenses                Expense[]
  expenseCategories       ExpenseCategory[]
  categories              Category[]
  products                Product[]
  suppliers               Supplier[]
  customers               Customer[]
  warehouses              Warehouse[]
  stocks                  Stock[]
  salesDeliveries         SalesDelivery[]
  salesOrderEvents        SalesOrderEvent[]
  purchaseReturns         PurchaseReturn[]
  salesReturns            SalesReturn[]
  journalEntries          JournalEntry[]
  landedCostTemplates     LandedCostTemplate[]

  @@map("users")
}

enum Role {
  ADMIN
  WAREHOUSE_MANAGER
  SALES_MANAGER
  SALES_OFFICER
  ACCOUNTANT
  STUDENT
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

model Category {
  id                 String   @id @default(cuid())
  name               String   @unique
  description        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  userId             String?
  user               User?    @relation(fields: [userId], references: [id])
  // Default accounts of the products in this category (null = the system
  // accounts Inventory / Sales / Cost of Goods Sold).
  inventoryAccountId String?
  inventoryAccount   Account? @relation("CategoryInventoryAccount", fields: [inventoryAccountId], references: [id])
  salesAccountId     String?
  salesAccount       Account? @relation("CategorySalesAccount", fields: [salesAccountId], references: [id])
  cogsAccountId      String?
  cogsAccount        Account? @relation("CategoryCogsAccount", fields: [cogsAccountId], references: [id])

  products Product[]

  @@index([userId])
  @@map("categories")
}

model Product {
  id                 String    @id @default(cuid())
  name               String
  sku                String    @unique
  description        String?
  categoryId         String
  category           Category  @relation(fields: [categoryId], references: [id])
  costPrice          Decimal   @default(0) @db.Decimal(12, 2)
  sellingPrice       Decimal   @default(0) @db.Decimal(12, 2)
  reorderLevel       Int       @default(10)
  // Optional, for allocating landed costs by weight (kg) or volume (m3) per unit.
  weight             Decimal?  @db.Decimal(12, 3)
  volume             Decimal?  @db.Decimal(12, 4)
  issueDate          DateTime?
  expireDate         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  userId             String?
  user               User?     @relation(fields: [userId], references: [id])
  // Account overrides (null = the category's account, then the system account).
  inventoryAccountId String?
  inventoryAccount   Account?  @relation("ProductInventoryAccount", fields: [inventoryAccountId], references: [id])
  salesAccountId     String?
  salesAccount       Account?  @relation("ProductSalesAccount", fields: [salesAccountId], references: [id])
  cogsAccountId      String?
  cogsAccount        Account?  @relation("ProductCogsAccount", fields: [cogsAccountId], references: [id])

  stock               Stock[]
  stockMovements      StockMovement[]
  purchaseOrderItems  PurchaseOrderItem[]
  salesOrderItems     SalesOrderItem[]
  stockTransferItems  StockTransferItem[]
  valuationEntries    InventoryValuationEntry[]
  purchaseReturnItems PurchaseReturnItem[]
  salesReturnItems    SalesReturnItem[]

  @@index([userId])
  @@index([categoryId])
  @@map("products")
}

model Supplier {
  id            String       @id @default(cuid())
  name          String
  email         String
  phone         String?
  address       String?
  city          String?
  state         String?
  zipCode       String?
  country       String?
  contactPerson String?
  // SERVICE_PROVIDER: paid for landed costs (clearing agent, transport, marketer...).
  type          SupplierType @default(GOODS)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  userId        String?
  user          User?        @relation(fields: [userId], references: [id])

  purchaseOrders          PurchaseOrder[]
  supplierPayments        SupplierPayment[]
  landedCosts             PurchaseLandedCost[]
  transferCosts           StockTransferCost[]
  purchaseReturns         PurchaseReturn[]
  journalLines            JournalLine[]
  landedCostTemplateItems LandedCostTemplateItem[]

  @@index([userId])
  @@map("suppliers")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  salesOrders      SalesOrder[]
  customerPayments CustomerPayment[]
  salesReturns     SalesReturn[]
  journalLines     JournalLine[]

  @@index([userId])
  @@map("customers")
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  city      String?
  state     String?
  zipCode   String?
  country   String?
  capacity  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  stock              Stock[]
  stockMovements     StockMovement[]
  valuationEntries   InventoryValuationEntry[]
  purchaseOrders     PurchaseOrder[]
  salesOrders        SalesOrder[]
  purchaseReturns    PurchaseReturn[]
  salesReturns       SalesReturn[]
  defaultForUsers    User[]                    @relation("UserDefaultWarehouse")
  fromStockTransfers StockTransfer[]           @relation("FromWarehouse")
  toStockTransfers   StockTransfer[]           @relation("ToWarehouse")

  @@index([userId])
  @@map("warehouses")
}

model Stock {
  id               String      @id @default(cuid())
  productId        String
  product          Product     @relation(fields: [productId], references: [id])
  warehouseId      String
  warehouse        Warehouse   @relation(fields: [warehouseId], references: [id])
  quantity         Int         @default(0)
  reservedQuantity Int         @default(0)
  // Weighted average unit cost in this warehouse (incl. landed costs), 4 decimals.
  avgCost          Decimal     @default(0) @db.Decimal(14, 4)
  status           StockStatus @default(IN_STOCK)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  userId           String?
  user             User?       @relation(fields: [userId], references: [id])

  @@unique([productId, warehouseId])
  @@index([userId])
  @@index([warehouseId])
  @@map("stock")
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

model StockMovement {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  type        MovementType
  quantity    Int
  reference   String?
  referenceId String?
  notes       String?
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  createdAt   DateTime     @default(now())

  @@index([createdAt])
  @@index([productId, warehouseId])
  @@index([userId, createdAt])
  @@map("stock_movements")
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

model PurchaseOrder {
  id                   String      @id @default(cuid())
  orderNumber          String      @unique
  supplierId           String
  supplier             Supplier    @relation(fields: [supplierId], references: [id])
  warehouseId          String
  warehouse            Warehouse   @relation(fields: [warehouseId], references: [id])
  orderDate            DateTime    @default(now())
  expectedDeliveryDate DateTime?
  status               OrderStatus @default(PENDING)
  subtotal             Decimal     @default(0) @db.Decimal(12, 2)
  tax                  Decimal     @default(0) @db.Decimal(12, 2)
  // Tax rate in % used for this order (from Settings at creation); every
  // recalculation of the order uses it, never the current Settings.
  taxRate              Decimal     @default(0) @db.Decimal(5, 2)
  discount             Decimal     @default(0) @db.Decimal(12, 2)
  total                Decimal     @default(0) @db.Decimal(12, 2)
  notes                String?
  // Landed costs finalized: afterwards only ADMIN can change them (with a reason).
  costsFinalizedAt     DateTime?
  costsFinalizedById   String?
  userId               String
  user                 User        @relation(fields: [userId], references: [id])
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  items            PurchaseOrderItem[]
  supplierPayments SupplierPayment[]
  receives         PurchaseReceive[]
  landedCosts      PurchaseLandedCost[]
  landedCostLogs   LandedCostLog[]
  returns          PurchaseReturn[]

  @@index([status])
  @@index([orderDate])
  @@index([supplierId])
  @@index([userId, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String        @id @default(cuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product       @relation(fields: [productId], references: [id])
  // Current (adjusted) quantity: changed by edits before the first receive,
  // over-receiving and closing the remainder. subtotal always follows it.
  quantity          Int
  // Quantity as ordered when the PO was created; never changes.
  originalQuantity  Int
  // The supplier will not deliver the rest; quantity was reduced to received.
  closed            Boolean       @default(false)
  unitPrice         Decimal       @db.Decimal(12, 2)
  subtotal          Decimal       @db.Decimal(12, 2)
  // Landed costs allocated to this line, and the part already applied to the
  // value of received units (stock / COGS). See lib/landed-costs.ts.
  landedCost        Decimal       @default(0) @db.Decimal(12, 2)
  appliedLandedCost Decimal       @default(0) @db.Decimal(12, 2)
  createdAt         DateTime      @default(now())

  receiveItems          PurchaseReceiveItem[]
  adjustments           PurchaseOrderItemAdjustment[]
  landedCostAllocations PurchaseLandedCostAllocation[]
  returnItems           PurchaseReturnItem[]
  valuationEntries      InventoryValuationEntry[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model PurchaseReceive {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  notes           String?
  createdAt       DateTime      @default(now())

  items       PurchaseReceiveItem[]
  adjustments PurchaseOrderItemAdjustment[]

  @@index([purchaseOrderId])
  @@map("purchase_receives")
}

model PurchaseReceiveItem {
  id                  String            @id @default(cuid())
  purchaseReceiveId   String
  purchaseReceive     PurchaseReceive   @relation(fields: [purchaseReceiveId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  // 0 only when the line's remainder is closed in this receive.
  quantityReceived    Int

  @@index([purchaseOrderItemId])
  @@map("purchase_receive_items")
}

// History of every change to a purchase order item's quantity, with who,
// when and why (the reason is required for OVER_RECEIVE / CLOSE_REMAINING).
model PurchaseOrderItemAdjustment {
  id                  String                 @id @default(cuid())
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem      @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  purchaseReceiveId   String?
  purchaseReceive     PurchaseReceive?       @relation(fields: [purchaseReceiveId], references: [id], onDelete: Cascade)
  type                PurchaseAdjustmentType
  oldQuantity         Int
  newQuantity         Int
  reason              String?
  userId              String
  user                User                   @relation(fields: [userId], references: [id])
  createdAt           DateTime               @default(now())

  @@index([purchaseOrderItemId])
  @@index([purchaseReceiveId])
  @@map("purchase_order_item_adjustments")
}

enum PurchaseAdjustmentType {
  EDIT
  OVER_RECEIVE
  CLOSE_REMAINING
}

enum SupplierType {
  GOODS
  SERVICE_PROVIDER
}

model SupplierPayment {
  id                  String              @id @default(cuid())
  supplierId          String
  supplier            Supplier            @relation(fields: [supplierId], references: [id])
  purchaseOrderId     String?
  purchaseOrder       PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id])
  amount              Decimal             @db.Decimal(12, 2)
  paymentDate         DateTime            @default(now())
  paymentMethod       String
  // Mobile money (EVC Plus, ZAAD, E-Dahab): payer phone as +252XXXXXXXXX and
  // the transaction ID from the confirmation SMS (lib/payment-methods.ts).
  payerPhone          String?
  transactionId       String?
  reference           String?
  // Optional: the landed cost line this payment settles.
  landedCostId        String?
  // Optional: the stock transfer cost this payment settles.
  stockTransferCostId String?
  stockTransferCost   StockTransferCost?  @relation(fields: [stockTransferCostId], references: [id])
  landedCost          PurchaseLandedCost? @relation(fields: [landedCostId], references: [id])
  notes               String?
  userId              String
  user                User                @relation(fields: [userId], references: [id])
  createdAt           DateTime            @default(now())

  // Cost lines this payment settles (one or many; see lib/cost-payments.ts).
  allocations SupplierPaymentAllocation[]

  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([paymentDate])
  @@index([userId, createdAt])
  @@map("supplier_payments")
}

model SalesOrder {
  id                   String           @id @default(cuid())
  orderNumber          String           @unique
  customerId           String
  customer             Customer         @relation(fields: [customerId], references: [id])
  warehouseId          String
  warehouse            Warehouse        @relation(fields: [warehouseId], references: [id])
  orderDate            DateTime         @default(now())
  expectedDeliveryDate DateTime?
  // Life cycle (lib/sales-orders.ts): DRAFT (no stock) -> CONFIRMED (stock
  // reserved) -> PARTIALLY_DELIVERED -> DELIVERED; or CANCELLED.
  status               SalesOrderStatus @default(DRAFT)
  // Reservation expiry (Settings salesReservationDays); expired reservations
  // are listed for managers to extend or release, never released automatically.
  reservedUntil        DateTime?
  confirmedAt          DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  cancelReason         String?
  subtotal             Decimal          @default(0) @db.Decimal(12, 2)
  tax                  Decimal          @default(0) @db.Decimal(12, 2)
  // Tax rate in % used for this order (from Settings at creation); every
  // recalculation of the order uses it, never the current Settings.
  taxRate              Decimal          @default(0) @db.Decimal(5, 2)
  // subtotal = sum of line subtotals (after item discounts).
  // discount = ORDER-level discount amount; itemDiscount = sum of line discounts.
  // total = (subtotal - discount) + tax, tax on the amount after all discounts.
  discount             Decimal          @default(0) @db.Decimal(12, 2)
  discountType         DiscountType?
  discountValue        Decimal          @default(0) @db.Decimal(12, 2)
  itemDiscount         Decimal          @default(0) @db.Decimal(12, 2)
  discountReason       String?
  total                Decimal          @default(0) @db.Decimal(12, 2)
  notes                String?
  userId               String
  user                 User             @relation(fields: [userId], references: [id])
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  items            SalesOrderItem[]
  customerPayments CustomerPayment[]
  deliveries       SalesDelivery[]
  events           SalesOrderEvent[]
  returns          SalesReturn[]

  @@index([status])
  @@index([reservedUntil])
  @@index([orderDate])
  @@index([customerId])
  @@index([userId, createdAt])
  @@map("sales_orders")
}

enum DiscountType {
  PERCENT
  AMOUNT
}

model SalesOrderItem {
  id                String        @id @default(cuid())
  salesOrderId      String
  salesOrder        SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product       @relation(fields: [productId], references: [id])
  quantity          Int
  // Delivered to the customer / released (cancelled or reservation released).
  // Still reserved = quantity - deliveredQuantity - releasedQuantity.
  deliveredQuantity Int           @default(0)
  releasedQuantity  Int           @default(0)
  // Returned by the customer (never more than delivered).
  returnedQuantity  Int           @default(0)
  unitPrice         Decimal       @db.Decimal(12, 2)
  // Line total after the line discount: quantity x unitPrice - discountAmount.
  subtotal          Decimal       @db.Decimal(12, 2)
  discountType      DiscountType?
  // Percent (0-100) or fixed amount, as entered.
  discountValue     Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount    Decimal       @default(0) @db.Decimal(12, 2)
  // Warehouse average cost per unit of the delivered units (COGS; each
  // delivery stores its own cost in sales_delivery_items).
  unitCost          Decimal       @default(0) @db.Decimal(14, 4)
  // true for lines sold before cost tracking (backfilled with the product cost).
  costEstimated     Boolean       @default(false)
  createdAt         DateTime      @default(now())

  deliveryItems SalesDeliveryItem[]
  returnItems   SalesReturnItem[]

  @@index([salesOrderId])
  @@index([productId])
  @@map("sales_order_items")
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

// A delivery (full or partial) of a sales order: the moment revenue, the
// customer debt and COGS are recorded. Amounts are the delivered share of the
// order (lib/sales-orders.ts); the deliveries of a fully delivered order add
// up exactly to the order totals.
model SalesDelivery {
  id             String              @id @default(cuid())
  deliveryNumber String              @unique
  salesOrderId   String
  salesOrder     SalesOrder          @relation(fields: [salesOrderId], references: [id])
  deliveredAt    DateTime            @default(now())
  // subtotal = delivered line amounts (after line discounts); discount = share
  // of the order discount; total = subtotal - discount + tax.
  subtotal       Decimal             @db.Decimal(12, 2)
  discount       Decimal             @db.Decimal(12, 2)
  tax            Decimal             @db.Decimal(12, 2)
  total          Decimal             @db.Decimal(12, 2)
  cogs           Decimal             @db.Decimal(12, 2)
  notes          String?
  userId         String
  user           User                @relation(fields: [userId], references: [id])
  createdAt      DateTime            @default(now())
  items          SalesDeliveryItem[]

  @@index([salesOrderId])
  @@index([deliveredAt])
  @@index([userId, createdAt])
  @@map("sales_deliveries")
}

model SalesDeliveryItem {
  id               String         @id @default(cuid())
  deliveryId       String
  delivery         SalesDelivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  salesOrderItemId String
  salesOrderItem   SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  productId        String
  quantity         Int
  // Line amount after the line discount, share of the order discount and of the tax.
  amount           Decimal        @db.Decimal(12, 2)
  discount         Decimal        @db.Decimal(12, 2)
  tax              Decimal        @db.Decimal(12, 2)
  unitCost         Decimal        @db.Decimal(14, 4)
  cogs             Decimal        @db.Decimal(12, 2)

  @@index([deliveryId])
  @@index([salesOrderItemId])
  @@map("sales_delivery_items")
}

// Audit trail of a sales order (created, edited, confirmed, delivered,
// cancelled, reservation extended / released, with reasons).
model SalesOrderEvent {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  type         String
  notes        String?
  data         Json?
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  createdAt    DateTime   @default(now())

  @@index([salesOrderId, createdAt])
  @@map("sales_order_events")
}

model CustomerPayment {
  id            String      @id @default(cuid())
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  salesOrderId  String?
  salesOrder    SalesOrder? @relation(fields: [salesOrderId], references: [id])
  amount        Decimal     @db.Decimal(12, 2)
  paymentDate   DateTime    @default(now())
  paymentMethod String
  // Mobile money (EVC Plus, ZAAD, E-Dahab): payer phone as +252XXXXXXXXX and
  // the transaction ID from the confirmation SMS (lib/payment-methods.ts).
  payerPhone    String?
  transactionId String?
  reference     String?
  notes         String?
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([customerId])
  @@index([salesOrderId])
  @@index([paymentDate])
  @@index([userId, createdAt])
  @@map("customer_payments")
}

// Warehouse-to-warehouse transfer (lib/stock-transfers.ts):
// DRAFT -> IN_TRANSIT -> PARTIALLY_RECEIVED / RECEIVED, or CANCELLED.
model StockTransfer {
  id              String         @id @default(cuid())
  transferNumber  String         @unique
  fromWarehouseId String
  fromWarehouse   Warehouse      @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse      @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  transferDate    DateTime       @default(now())
  expectedDate    DateTime?
  status          TransferStatus @default(DRAFT)
  // Dispatched and received in one step (nearby warehouses).
  instant         Boolean        @default(false)
  notes           String?
  dispatchedAt    DateTime?
  dispatchedById  String?
  receivedAt      DateTime?
  cancelledAt     DateTime?
  cancelledById   String?
  cancelReason    String?
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items    StockTransferItem[]
  receipts StockTransferReceipt[]
  events   StockTransferEvent[]
  costs    StockTransferCost[]

  @@index([status])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([userId, createdAt])
  @@map("stock_transfers")
}

model StockTransferItem {
  id                 String        @id @default(cuid())
  stockTransferId    String
  stockTransfer      StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  productId          String
  product            Product       @relation(fields: [productId], references: [id])
  // Planned quantity (draft); dispatched is what actually left the source.
  quantity           Int
  dispatchedQuantity Int           @default(0)
  receivedQuantity   Int           @default(0)
  lostQuantity       Int           @default(0)
  returnedQuantity   Int           @default(0)
  // Source average cost per unit at dispatch (value of the goods in transit).
  unitCost           Decimal       @default(0) @db.Decimal(14, 4)
  // Transfer costs allocated to this line; the part applied to the
  // destination stock (received units) and the part booked as loss
  // (lost / returned units).
  allocatedCost      Decimal       @default(0) @db.Decimal(12, 2)
  appliedCost        Decimal       @default(0) @db.Decimal(12, 2)
  lossCost           Decimal       @default(0) @db.Decimal(12, 2)
  createdAt          DateTime      @default(now())

  receiptItems     StockTransferReceiptItem[]
  valuationEntries InventoryValuationEntry[]

  @@index([stockTransferId])
  @@map("stock_transfer_items")
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum TransferReceiptType {
  RECEIVE
  CLOSE
}

// One receipt at the destination, or one "close remaining" action.
model StockTransferReceipt {
  id              String              @id @default(cuid())
  stockTransferId String
  stockTransfer   StockTransfer       @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  type            TransferReceiptType @default(RECEIVE)
  notes           String?
  userId          String
  user            User                @relation(fields: [userId], references: [id])
  createdAt       DateTime            @default(now())

  items StockTransferReceiptItem[]

  @@index([stockTransferId])
  @@map("stock_transfer_receipts")
}

model StockTransferReceiptItem {
  id                  String               @id @default(cuid())
  receiptId           String
  receipt             StockTransferReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  stockTransferItemId String
  stockTransferItem   StockTransferItem    @relation(fields: [stockTransferItemId], references: [id], onDelete: Cascade)
  receivedQuantity    Int                  @default(0)
  lostQuantity        Int                  @default(0)
  returnedQuantity    Int                  @default(0)
  // Required for lost (damaged / missing), returned and written-off units.
  reason              String?

  @@index([stockTransferItemId])
  @@map("stock_transfer_receipt_items")
}

// Timeline: created, dispatched, received, closed, cancelled, cost changes.
model StockTransferEvent {
  id              String        @id @default(cuid())
  stockTransferId String
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  type            String
  notes           String?
  data            Json?
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  createdAt       DateTime      @default(now())

  @@index([stockTransferId, createdAt])
  @@map("stock_transfer_events")
}

// Optional cost of the transfer (e.g. transport), owed to a service
// provider, allocated by value and added to the destination landed cost.
model StockTransferCost {
  id               String         @id @default(cuid())
  stockTransferId  String
  stockTransfer    StockTransfer  @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  typeId           String
  type             LandedCostType @relation(fields: [typeId], references: [id])
  paidToSupplierId String
  paidToSupplier   Supplier       @relation(fields: [paidToSupplierId], references: [id])
  amount           Decimal        @db.Decimal(12, 2)
  reference        String?
  costDate         DateTime       @default(now())
  notes            String?
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  supplierPayments   SupplierPayment[]
  paymentAllocations SupplierPaymentAllocation[]

  @@index([stockTransferId])
  @@index([paidToSupplierId])
  @@map("stock_transfer_costs")
}

enum OrderStatus {
  PENDING
  PARTIALLY_RECEIVED
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model ExpenseCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  // lower(trim(name)): makes names unique case-insensitively (set by the API).
  nameKey     String   @unique
  description String?
  // Inactive categories stay on old expenses but cannot be chosen for new ones.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  // Expense account the expenses of this category are booked to.
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])

  expenses Expense[]

  @@index([userId])
  @@map("expense_categories")
}

model Expense {
  id            String          @id @default(cuid())
  categoryId    String
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount        Decimal         @db.Decimal(12, 2)
  description   String
  expenseDate   DateTime        @default(now())
  paymentMethod String
  // Mobile money (EVC Plus, ZAAD, E-Dahab): payer phone as +252XXXXXXXXX and
  // the transaction ID from the confirmation SMS (lib/payment-methods.ts).
  payerPhone    String?
  transactionId String?
  reference     String?
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([expenseDate])
  @@index([userId, createdAt])
  @@map("expenses")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

enum PermissionScope {
  ALL
  OWN
}

// Permissions per role and module (see lib/permission-rules.ts). ADMIN is
// not stored: it always has full access. Edited on the Roles & Permissions page.
model RolePermission {
  id            String          @id @default(cuid())
  role          Role
  module        String
  canView       Boolean         @default(false)
  canCreate     Boolean         @default(false)
  canEdit       Boolean         @default(false)
  canDelete     Boolean         @default(false)
  scope         PermissionScope @default(ALL)
  // sales_discount only: maximum total discount in %, null = no limit.
  discountLimit Decimal?        @db.Decimal(5, 2)
  updatedAt     DateTime        @updatedAt

  @@unique([role, module])
  @@map("role_permissions")
}

// Audit log of every permission change on the Roles & Permissions page.
model PermissionChangeLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      Role
  module    String
  before    Json
  after     Json
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("permission_change_logs")
}

// --- Landed costs (lib/landed-costs.ts) ----------------------------------------

// Manageable, global list of cost types (landed_cost_types permission).
model LandedCostType {
  id        String   @id @default(cuid())
  name      String   @unique
  nameKey   String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  costs         PurchaseLandedCost[]
  transferCosts StockTransferCost[]
  templateItems LandedCostTemplateItem[]

  @@map("landed_cost_types")
}

enum LandedCostAmountType {
  FIXED
  PERCENT
}

enum LandedCostPercentBase {
  // % of the goods value (PO subtotal, before tax)
  GOODS
  // % of the goods value + the other FIXED cost lines of the same PO
  GOODS_PLUS_FIXED
}

enum LandedCostAllocation {
  VALUE
  QUANTITY
  WEIGHT
  VOLUME
  MANUAL
}

// An extra cost of a purchase (shipment, customs, transport, commission...),
// owed to a service provider and allocated to the PO lines.
model PurchaseLandedCost {
  id               String                @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  typeId           String
  type             LandedCostType        @relation(fields: [typeId], references: [id])
  paidToSupplierId String
  paidToSupplier   Supplier              @relation(fields: [paidToSupplierId], references: [id])
  amountType       LandedCostAmountType  @default(FIXED)
  // FIXED: the amount; PERCENT: the percentage (0-100)
  value            Decimal               @db.Decimal(12, 4)
  percentBase      LandedCostPercentBase @default(GOODS)
  // Calculated amount (recalculated when PO quantities change)
  amount           Decimal               @db.Decimal(12, 2)
  allocationMethod LandedCostAllocation  @default(VALUE)
  reference        String?
  costDate         DateTime              @default(now())
  notes            String?
  userId           String
  user             User                  @relation(fields: [userId], references: [id])
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  allocations        PurchaseLandedCostAllocation[]
  supplierPayments   SupplierPayment[]
  paymentAllocations SupplierPaymentAllocation[]
  valuationEntries   InventoryValuationEntry[]

  @@index([purchaseOrderId])
  @@index([paidToSupplierId])
  @@map("purchase_landed_costs")
}

// The part of a supplier payment that settles one cost line (a landed cost of
// a purchase order or a stock transfer cost). A line is paid when its
// allocations reach its amount. Exactly one of the two links is set (CHECK).
model SupplierPaymentAllocation {
  id                  String              @id @default(cuid())
  paymentId           String
  payment             SupplierPayment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  landedCostId        String?
  landedCost          PurchaseLandedCost? @relation(fields: [landedCostId], references: [id], onDelete: Cascade)
  stockTransferCostId String?
  stockTransferCost   StockTransferCost?  @relation(fields: [stockTransferCostId], references: [id], onDelete: Cascade)
  amount              Decimal             @db.Decimal(12, 2)
  createdAt           DateTime            @default(now())

  @@index([paymentId])
  @@index([landedCostId])
  @@index([stockTransferCostId])
  @@map("supplier_payment_allocations")
}

model PurchaseLandedCostAllocation {
  id                  String             @id @default(cuid())
  landedCostId        String
  landedCost          PurchaseLandedCost @relation(fields: [landedCostId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem  @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  // MANUAL only: the amount entered (the weight if the cost amount changes later)
  manualAmount        Decimal?           @db.Decimal(12, 2)
  // Allocated amount; the allocations of a cost sum exactly to its amount
  amount              Decimal            @db.Decimal(12, 2)

  @@unique([landedCostId, purchaseOrderItemId])
  @@index([purchaseOrderItemId])
  @@map("purchase_landed_cost_allocations")
}

// Every change to landed costs: who, when, what (and why, after finalizing).
model LandedCostLog {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  landedCostId    String?
  action          String
  before          Json?
  after           Json?
  reason          String?
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  createdAt       DateTime      @default(now())

  @@index([purchaseOrderId, createdAt])
  @@map("landed_cost_logs")
}

enum ValuationEntryType {
  RECEIPT
  LANDED_COST
  COGS_ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  // lost / damaged in transit, or transfer cost of units that did not arrive
  TRANSFER_LOSS
  // goods sent back to the source at their dispatch cost
  TRANSFER_RETURN
  // goods returned to the supplier, at the warehouse average cost
  PURCHASE_RETURN
  // manual stock correction at the average cost (quantity and amount are signed)
  STOCK_ADJUSTMENT
  // initial stock entered with a new product (at its cost price)
  OPENING_STOCK
  // resellable goods returned by a customer, back in stock at their original cost
  SALES_RETURN
  // damaged goods returned by a customer: a loss at their original cost
  SALES_RETURN_LOSS
}

// Inventory valuation ledger. COGS_ADJUSTMENT = the part of a later landed
// cost change that belongs to units already sold (counted in profit reports).
model InventoryValuationEntry {
  id                  String              @id @default(cuid())
  type                ValuationEntryType
  productId           String
  product             Product             @relation(fields: [productId], references: [id])
  warehouseId         String
  warehouse           Warehouse           @relation(fields: [warehouseId], references: [id])
  quantity            Int                 @default(0)
  amount              Decimal             @db.Decimal(12, 2)
  purchaseOrderItemId String?
  purchaseOrderItem   PurchaseOrderItem?  @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)
  stockTransferItemId String?
  stockTransferItem   StockTransferItem?  @relation(fields: [stockTransferItemId], references: [id], onDelete: SetNull)
  landedCostId        String?
  landedCost          PurchaseLandedCost? @relation(fields: [landedCostId], references: [id], onDelete: SetNull)
  userId              String
  user                User                @relation(fields: [userId], references: [id])
  createdAt           DateTime            @default(now())

  @@index([type, createdAt])
  @@index([productId, warehouseId])
  @@map("inventory_valuation_entries")
}

// Goods sent back to the supplier (PR-000001). The units leave the warehouse
// at its average (landed) cost (costValue). The supplier balance goes down by
// creditTotal: the purchase price of the units, less their share of the
// order discount, plus their share of the tax. refundAmount is money the
// supplier paid back (0 = the credit stays on the supplier account); it
// raises the balance again. Returns are final (lib/purchase-returns.ts).
model PurchaseReturn {
  id              String        @id @default(cuid())
  returnNumber    String        @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  supplierId      String
  supplier        Supplier      @relation(fields: [supplierId], references: [id])
  warehouseId     String
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id])
  returnDate      DateTime      @default(now())
  reason          String
  notes           String?
  goodsAmount     Decimal       @db.Decimal(12, 2)
  discount        Decimal       @db.Decimal(12, 2)
  tax             Decimal       @db.Decimal(12, 2)
  creditTotal     Decimal       @db.Decimal(12, 2)
  costValue       Decimal       @db.Decimal(12, 2)
  refundAmount    Decimal       @default(0) @db.Decimal(12, 2)
  refundMethod    String?
  payerPhone      String?
  transactionId   String?
  refundReference String?
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  createdAt       DateTime      @default(now())

  items PurchaseReturnItem[]

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([returnDate])
  @@index([userId, createdAt])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id                  String            @id @default(cuid())
  purchaseReturnId    String
  purchaseReturn      PurchaseReturn    @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  productId           String
  product             Product           @relation(fields: [productId], references: [id])
  quantity            Int
  unitPrice           Decimal           @db.Decimal(12, 2)
  amount              Decimal           @db.Decimal(12, 2)
  unitCost            Decimal           @db.Decimal(14, 4)
  costValue           Decimal           @db.Decimal(12, 2)

  @@index([purchaseReturnId])
  @@index([purchaseOrderItemId])
  @@map("purchase_return_items")
}

enum ReturnCondition {
  // back to stock at the original unit cost
  RESELLABLE
  // not sellable: booked as a loss at the original unit cost
  DAMAGED
}

// Delivered goods returned by the customer (credit note SR-000001). Revenue
// (subtotal - discount), tax and COGS of the returned units are reversed in
// the same proportions as the order; the customer balance goes down by
// total (and up again by refundAmount when money is paid back). Returns are
// final (lib/sales-returns.ts).
model SalesReturn {
  id              String     @id @default(cuid())
  returnNumber    String     @unique
  salesOrderId    String
  salesOrder      SalesOrder @relation(fields: [salesOrderId], references: [id])
  customerId      String
  customer        Customer   @relation(fields: [customerId], references: [id])
  warehouseId     String
  warehouse       Warehouse  @relation(fields: [warehouseId], references: [id])
  returnDate      DateTime   @default(now())
  reason          String
  notes           String?
  subtotal        Decimal    @db.Decimal(12, 2)
  discount        Decimal    @db.Decimal(12, 2)
  tax             Decimal    @db.Decimal(12, 2)
  total           Decimal    @db.Decimal(12, 2)
  // Original cost of all returned units (COGS reversed), of which lossValue
  // is damaged (a loss) and the rest went back to stock.
  cogs            Decimal    @db.Decimal(12, 2)
  lossValue       Decimal    @default(0) @db.Decimal(12, 2)
  refundAmount    Decimal    @default(0) @db.Decimal(12, 2)
  refundMethod    String?
  payerPhone      String?
  transactionId   String?
  refundReference String?
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  createdAt       DateTime   @default(now())

  items SalesReturnItem[]

  @@index([salesOrderId])
  @@index([customerId])
  @@index([returnDate])
  @@index([userId, createdAt])
  @@map("sales_returns")
}

model SalesReturnItem {
  id               String          @id @default(cuid())
  salesReturnId    String
  salesReturn      SalesReturn     @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  salesOrderItemId String
  salesOrderItem   SalesOrderItem  @relation(fields: [salesOrderItemId], references: [id])
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  quantity         Int
  condition        ReturnCondition
  amount           Decimal         @db.Decimal(12, 2)
  discount         Decimal         @db.Decimal(12, 2)
  tax              Decimal         @db.Decimal(12, 2)
  unitCost         Decimal         @db.Decimal(14, 4)
  cogs             Decimal         @db.Decimal(12, 2)

  @@index([salesReturnId])
  @@index([salesOrderItemId])
  @@map("sales_return_items")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

// Where an account appears in the reports (balance sheet sections, P&L lines).
enum AccountGroup {
  CASH_AND_BANK
  RECEIVABLE
  INVENTORY
  OTHER_ASSET
  PAYABLE
  TAX
  OTHER_LIABILITY
  EQUITY
  SALES
  SALES_RETURNS
  OTHER_INCOME
  COGS
  OPERATING_EXPENSE
  LOSS
  OTHER_EXPENSE
}

// Chart of accounts. systemKey marks the accounts the automatic journals use
// (CASH, AR, INVENTORY, AP, SALES, COGS, ...); those cannot be deleted or
// change type (lib/accounting.ts).
model Account {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  type        AccountType
  group       AccountGroup
  systemKey   String?      @unique
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  lines                     JournalLine[]
  categoryInventoryAccounts Category[]        @relation("CategoryInventoryAccount")
  categorySalesAccounts     Category[]        @relation("CategorySalesAccount")
  categoryCogsAccounts      Category[]        @relation("CategoryCogsAccount")
  productInventoryAccounts  Product[]         @relation("ProductInventoryAccount")
  productSalesAccounts      Product[]         @relation("ProductSalesAccount")
  productCogsAccounts       Product[]         @relation("ProductCogsAccount")
  expenseCategories         ExpenseCategory[]

  @@index([type])
  @@map("accounts")
}

// Double-entry journal, posted automatically from the business documents
// (lib/accounting.ts). A document's journal is the SUM of all entries with its
// (sourceType, sourceId): the first entry books it, later entries only book
// the difference after an edit or a delete (never rewritten). Entries and
// lines are immutable and every entry balances (database triggers).
model JournalEntry {
  id           String   @id @default(cuid())
  entryNumber  String   @unique
  date         DateTime
  description  String
  sourceType   String
  sourceId     String
  reference    String?
  isAdjustment Boolean  @default(false)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())

  lines JournalLine[]

  @@index([sourceType, sourceId])
  @@index([date])
  @@map("journal_entries")
}

model JournalLine {
  id         String       @id @default(cuid())
  entryId    String
  entry      JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account      @relation(fields: [accountId], references: [id])
  debit      Decimal      @default(0) @db.Decimal(12, 2)
  credit     Decimal      @default(0) @db.Decimal(12, 2)
  memo       String?
  // Sub-ledger party of Accounts Payable / Receivable lines: a supplier's
  // payable is exactly the sum of its AP lines (lib/balances.ts).
  supplierId String?
  supplier   Supplier?    @relation(fields: [supplierId], references: [id])
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@index([supplierId])
  @@index([customerId])
  @@map("journal_lines")
}

// A saved set of landed costs (e.g. the usual customs + clearing + transport
// of one route) applied to a purchase order in one click; every line is then
// an ordinary landed cost, validated and editable as usual.
model LandedCostTemplate {
  id          String   @id @default(cuid())
  name        String
  nameKey     String   @unique
  description String?
  isActive    Boolean  @default(true)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items LandedCostTemplateItem[]

  @@map("landed_cost_templates")
}

model LandedCostTemplateItem {
  id               String                @id @default(cuid())
  templateId       String
  template         LandedCostTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  typeId           String
  type             LandedCostType        @relation(fields: [typeId], references: [id])
  // null = chosen when the template is applied (defaults to the PO supplier)
  paidToSupplierId String?
  paidToSupplier   Supplier?             @relation(fields: [paidToSupplierId], references: [id])
  amountType       LandedCostAmountType  @default(FIXED)
  value            Decimal               @db.Decimal(12, 4)
  percentBase      LandedCostPercentBase @default(GOODS)
  allocationMethod LandedCostAllocation  @default(VALUE)
  sortOrder        Int                   @default(0)

  @@index([templateId])
  @@map("landed_cost_template_items")
}
