# Copy to .env (local dev) and fill in real values. Never commit .env.
DATABASE_URL="postgresql://<db-user>:<db-password>@<db-host>:5432/<db-name>?sslmode=require"

# Auth.js secret used to sign/encrypt session cookies.
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="<generate-a-random-32-byte-secret>"

# Used by `npm run db:seed` to create the first ADMIN user.
# If ADMIN_PASSWORD is empty, a strong random password is generated and printed once.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
